restart        1000  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_1H/results/700K/checkpoints/nvt_700K.*.restart

pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

group          H_atom  type 8
1 atoms in group H_atom
group          metal   subtract all H_atom
32 atoms in group metal

thermo         100
thermo_style   custom step temp pe ke etotal press vol

timestep       0.001

velocity       all create 700.0 12345 mom yes rot yes dist gaussian

