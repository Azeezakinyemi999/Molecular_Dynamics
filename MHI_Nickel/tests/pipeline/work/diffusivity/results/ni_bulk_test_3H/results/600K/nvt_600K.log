package kokkos
package kokkos newton on neigh half
# LAMMPS NVT bulk equilibration — Hastelloy N + H
# T = 600 K | Notebook 10
# Phase 1: 0 ps equilibration
# Phase 2: 2 ps production (trajectory for NB11 MSD)

units          metal
atom_style     atomic
newton         on
boundary       p p p

read_data      /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/structures/600K/bulk_min_h.lammps
