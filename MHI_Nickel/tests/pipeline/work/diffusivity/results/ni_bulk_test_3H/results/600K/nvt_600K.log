restart        1000  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/results/600K/checkpoints/nvt_600K.*.restart

pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

group          H_atom  type 8
3 atoms in group H_atom
group          metal   subtract all H_atom
32 atoms in group metal

thermo         100
thermo_style   custom step temp pe ke etotal press vol

timestep       0.001

velocity       all create 600.0 12345 mom yes rot yes dist gaussian

# ═══ PHASE 1: Equilibration (0 ps) ═══════════════════════════
fix            nvt_equil  all  nvt  temp  600.0  600.0  0.1

dump           equil_dump  all  custom  100  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/results/600K/nvt_600K_phase1_equil.lammpstrj  id type x y z
dump_modify    equil_dump  sort id

compute        msd_H      H_atom  msd
fix            msd_equil  all  ave/time  1  1  100                c_msd_H[4]  file  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/results/600K/msd_600K_equil.dat  mode scalar

print "### Phase 1: Equilibration 0 ps at 600 K ###"
