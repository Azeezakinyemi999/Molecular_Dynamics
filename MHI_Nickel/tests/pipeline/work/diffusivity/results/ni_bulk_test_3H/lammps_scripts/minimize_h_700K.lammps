# ════════════════════════════════════════════════════
# LAMMPS Energy Minimization — Hastelloy N Bulk
# Notebook 02 | pair_style: mliap unified
# ════════════════════════════════════════════════════

units          metal
atom_style     atomic
newton         on
boundary       p p p

read_data      /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/structures/700K/bulk_3H_initial.lammps



pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

thermo         10
thermo_style   custom step pe fmax fnorm press vol lx ly lz

fix            boxrelax all box/relax iso 0.0 vmax 0.001

print "### Minimization ###"

minimize       0.0 1e-08 50000 500000

print "### Minimization complete ###"

unfix          boxrelax

variable       pe_final  equal  pe
variable       natoms    equal  atoms
variable       ecoh      equal  -v_pe_final/v_natoms
variable       a0_min    equal  lx/5
variable       fmax_f    equal  fmax

print "MINIMIZATION_RESULTS_START"
print "  Total_energy_eV     : ${pe_final}"
print "  Natoms              : ${natoms}"
print "  Ecoh_eV_per_atom    : ${ecoh}"
print "  a0_Angstrom         : ${a0_min}"
print "  Fmax_eV_per_Ang     : ${fmax_f}"
print "MINIMIZATION_RESULTS_END"

write_restart  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/structures/700K/bulk_min_h_final.restart
write_data     /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/structures/700K/bulk_min_h.lammps
print "Minimized structure written to /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_3H/structures/700K/bulk_min_h.lammps"
