package kokkos
package kokkos newton on neigh half
# ════════════════════════════════════════════════════
# LAMMPS NPT — Lattice Parameter at 700 K
# Notebook 02
# ════════════════════════════════════════════════════

units          metal
atom_style     atomic
newton         on
boundary       p p p

read_data      /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_1H/structures/bulk_min.lammps
Reading data file ...
  orthogonal box = (0.0049156635 0.0049156635 0.0049156635) to (7.0350843 7.0350843 7.0350843)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  32 atoms
  reading velocities ...
  32 velocities
  read_data CPU = 0.029 seconds



pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

timestep       0.001

velocity       all create 10.0 12345 mom yes rot yes dist gaussian

thermo         100
thermo_style   custom step time temp pe ke press vol lx ly lz

# ── Stage 1: Heat 10 K → 700 K over 0 ps ──────────────
fix            heat all npt temp 10.0 700.0 0.1                iso 0.0 0.0 1.0
run            500

