# ── Stage 2: NPT production at 600 K (0 ps) ────────────
fix            npt_run all npt temp 600.0 600.0 0.1                iso 0.0 0.0 1.0

variable       lx_val  equal  lx
variable       ly_val  equal  ly
variable       lz_val  equal  lz
