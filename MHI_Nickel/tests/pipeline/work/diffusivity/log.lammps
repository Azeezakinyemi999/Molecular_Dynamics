# ── Stage 2: NPT production at 600 K (0 ps) ────────────
fix            npt_run all npt temp 600.0 600.0 0.1                iso 0.0 0.0 1.0

variable       lx_val  equal  lx
variable       ly_val  equal  ly
variable       lz_val  equal  lz
fix            boxdump all ave/time 1 1 100 v_lx_val v_ly_val v_lz_val                file /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/diffusivity/results/ni_bulk_test_1H/structures/npt_boxdims_600K.dat

run            500
