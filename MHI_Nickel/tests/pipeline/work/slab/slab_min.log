units          metal
atom_style     atomic
newton         on
boundary       p p f

read_data      /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/tests/pipeline/work/slab/slab_raw.lammps
Reading data file ...
  orthogonal box = (0 0 0) to (4.9780317 4.9780317 30.161365)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  24 atoms
  read_data CPU = 0.010 seconds

pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

# ── Freeze bottom layers (z ≤ 13.0484094213 Å) ─────────────────────────────
region         frozen_reg   block  INF INF  INF INF  EDGE  13.0484094213
group          frozen_atoms region frozen_reg
8 atoms in group frozen_atoms
group          free_atoms   subtract all frozen_atoms
16 atoms in group free_atoms

fix            freeze  frozen_atoms  setforce  0.0  0.0  0.0

thermo         100
thermo_style   custom  step  pe  fmax  fnorm  press

print "### Adsorbate minimization ###"
### Adsorbate minimization ###

minimize       0.0  1e-06  10000  100000

