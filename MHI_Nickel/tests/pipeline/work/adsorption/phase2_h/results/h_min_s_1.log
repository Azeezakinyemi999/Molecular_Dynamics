  read_data CPU = 0.015 seconds

pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

# ── Freeze bottom layers (z ≤ 12.937141094725071 Å) ─────────────────────────────
region         frozen_reg   block  INF INF  INF INF  EDGE  12.937141094725071
group          frozen_atoms region frozen_reg
8 atoms in group frozen_atoms
group          free_atoms   subtract all frozen_atoms
17 atoms in group free_atoms

fix            freeze  frozen_atoms  setforce  0.0  0.0  0.0

thermo         100
thermo_style   custom  step  pe  fmax  fnorm  press

print "### Adsorbate minimization ###"
### Adsorbate minimization ###

minimize       0.0  1e-06  10000  100000

