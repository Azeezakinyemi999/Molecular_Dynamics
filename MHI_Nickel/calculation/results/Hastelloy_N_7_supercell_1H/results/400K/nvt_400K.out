package kokkos
package kokkos newton on neigh half
# LAMMPS NVT bulk RESTART — Hastelloy N + H
# T = 400 K | Notebook 10 (continuation leg)
# Phase 1: 1000 ps equilibration (resumed from checkpoint)
# Phase 2: 2500 ps production   (trajectory appended)

