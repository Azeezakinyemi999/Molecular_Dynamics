# ════════════════════════════════════════════════════
# LAMMPS NPT RESTART — Stage 2 only at 600 K
# Notebook 02 (continuation leg)
# Reads *_after_heat.restart; appends box dims to existing dump
# ════════════════════════════════════════════════════

units          metal
atom_style     atomic
newton         on
boundary       p p p

# Velocities and thermostat state are restored from the checkpoint.
# No velocity command needed.
read_restart   /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/npt_boxdims_600K_after_heat.restart



pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

timestep       0.0005

thermo         1000
thermo_style   custom step time temp pe ke press vol lx ly lz

# ── Stage 2: NPT production at 600 K (250 ps) ────────────
fix            npt_run all npt temp 600.0 600.0 0.1 &
               iso 0.0 0.0 1.0

variable       lx_val  equal  lx
variable       ly_val  equal  ly
variable       lz_val  equal  lz
fix            boxdump all ave/time 1 1 1000 v_lx_val v_ly_val v_lz_val &
               file /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/npt_boxdims_600K.dat  append yes

run            500000
unfix          npt_run
unfix          boxdump
print "### NPT restart complete at 600 K ###"

variable       a0_npt  equal  lx/5.0
print "NPT_RESULT: a0_at_600K = ${a0_npt} Angstrom"

write_restart  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/npt_boxdims_600K_final.restart
write_data     /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/bulk_min_npt_final_600K.lammps
