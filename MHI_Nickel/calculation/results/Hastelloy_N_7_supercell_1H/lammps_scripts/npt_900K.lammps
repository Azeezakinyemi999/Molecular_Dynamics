# ════════════════════════════════════════════════════
# LAMMPS NPT — Lattice Parameter at 900 K
# Notebook 02
# ════════════════════════════════════════════════════

units          metal
atom_style     atomic
newton         on
boundary       p p p

read_data      /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/bulk_min.lammps



pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mh-1.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

timestep       0.0005

velocity       all create 10.0 12345 mom yes rot yes dist gaussian

thermo         1000
thermo_style   custom step time temp pe ke press vol lx ly lz

# ── Stage 1: Heat 10 K → 900 K over 50 ps ──────────────
fix            heat all npt temp 10.0 900.0 0.1 &
               iso 0.0 0.0 1.0
run            100000
unfix          heat
print "### Heating complete ###"

write_restart  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/npt_boxdims_900K_after_heat.restart
write_data     /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/bulk_min_npt_after_heat.lammps

# ── Stage 2: NPT production at 900 K (250 ps) ────────────
fix            npt_run all npt temp 900.0 900.0 0.1 &
               iso 0.0 0.0 1.0

variable       lx_val  equal  lx
variable       ly_val  equal  ly
variable       lz_val  equal  lz
fix            boxdump all ave/time 1 1 1000 v_lx_val v_ly_val v_lz_val &
               file /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/npt_boxdims_900K.dat

run            500000

unfix          npt_run
unfix          boxdump
print "### NPT complete at 900 K ###"

variable       a0_npt  equal  lx/5.0
print "NPT_RESULT: a0_at_900K = ${a0_npt} Angstrom"

write_restart  /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/npt_boxdims_900K_final.restart
write_data     /projects/westgroup/akinyemi.az/mace_lammps/MHI_Nickel/calculation/results/Hastelloy_N_7_supercell_1H/structures/bulk_min_npt_final_900K.lammps
