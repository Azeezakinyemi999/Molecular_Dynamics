# LAMMPS NVT bulk equilibration — Hastelloy N + 1H
# T = 1200 K | Notebook 10
# Phase 1: 250 ps equilibration
# Phase 2: 750 ps production (trajectory for NB11 MSD)
# Refs: NVT [6]; H diffusion [1,2]

units          metal
atom_style     atomic
newton         on
boundary       p p p

read_data      structures/notebook10-bulk-equilibration/Pure_Nickel/Pure_Nickel_H_initial.lammps

pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mp-0b2-medium.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni O H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

# ── Identify H atom for tracking ─────────────────────────────
group          H_atom   type 9
group          metal    subtract all H_atom

# ── Thermo ───────────────────────────────────────────────────
thermo         1000
thermo_style   custom step temp pe ke etotal press vol

# ── Timestep ─────────────────────────────────────────────────
timestep       0.0005

# ── Initialize velocities ────────────────────────────────────
velocity       all create 1200.0 42 mom yes rot yes dist gaussian

# ── Phase 1: Equilibration ───────────────────────────────────
fix            nvt_equil  all  nvt  temp  1200.0  1200.0  0.1
print "### Phase 1: Equilibration 250 ps at 1200 K ###"
run            500000
unfix          nvt_equil

# ── Phase 2: Production ──────────────────────────────────────
# Dump trajectory for NB11 MSD calculation
# Dump every 1000 steps = 500 fs
dump           prod_dump  all  custom  1000  results/notebook10-bulk-equilibration/Pure_Nickel/Pure_Nickel_H_1200K_prod.lammpstrj &
               id type x y z
dump_modify    prod_dump  sort id

fix            nvt_prod  all  nvt  temp  1200.0  1200.0  0.1

# Compute MSD for H atom
compute        msd_H  H_atom  msd
fix            msd_out  all  ave/time  1  1  1000 &
               c_msd_H[4]  file  results/notebook10-bulk-equilibration/Pure_Nickel/Pure_Nickel_msd_H_1200K.txt  mode scalar

print "### Phase 2: Production 750 ps at 1200 K ###"
run            1500000

# ── Save final state ─────────────────────────────────────────
variable  pe_final  equal  pe
variable  temp_fin  equal  temp
variable  press_fin equal  press

print "EQUIL_RESULTS_START"
print "  T_K          : 1200"
print "  pe_final_eV  : ${pe_final}"
print "  temp_final_K : ${temp_fin}"
print "  press_final  : ${press_fin}"
print "EQUIL_RESULTS_END"

write_data     structures/notebook10-bulk-equilibration/Pure_Nickel/Pure_Nickel_H_1200K.lammps
