units metal
atom_style atomic
newton on
boundary p p f

read_data      structures/notebook06-Neb-dissociation/7/multi/bridge__top_mo+top_cr/neb_final_raw.lammps

pair_style     mliap unified /projects/westgroup/akinyemi.az/mace_lammps/models/mace-mp-0b2-medium.model-mliap_lammps.pt 0
pair_coeff     * * Al B C Cr Fe Mo Ni H

neighbor       2.0 bin
neigh_modify   every 1 delay 0 check yes

region         frozen_reg block INF INF INF INF EDGE 22.115
group          frozen_atoms region frozen_reg
group          free_atoms subtract all frozen_atoms
fix            freeze frozen_atoms setforce 0.0 0.0 0.0

thermo         50
thermo_style   custom step pe fmax

minimize       0 1e-06 10000 100000

variable pe_final equal pe
variable fmax_f   equal fmax

print "ENERGY_RESULTS_START"
print "  job_name         : fs_min_bridge__top_mo+top_cr"
print "  pe_final_eV      : ${pe_final}"
print "  fmax_eV_per_Ang  : ${fmax_f}"
print "ENERGY_RESULTS_END"

write_data structures/notebook06-Neb-dissociation/7/multi/bridge__top_mo+top_cr/neb_final_relaxed.lammps
